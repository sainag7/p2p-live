# Copy to .env.local and fill in your own values. Never commit real keys.

# Mapbox token used by the public rider map in the browser.
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Server-only Mapbox token for public place search and walking directions.
MAPBOX_TOKEN=your_mapbox_token_here

# GMV Syncromatics RTPI key for live routes, vehicle positions, arrivals, and service status.
# Keep this server-only: never prefix it with VITE_.
GMV_RTPI_API_KEY=your_gmv_rtpi_api_key_here

# Optional public API deployment URL. Leave empty locally so Vite proxies /api to npm run server.
VITE_API_BASE_URL=

# Optional Vite proxy override, for example a deployed API while developing the frontend.
# VITE_API_PROXY_TARGET=https://p2p-live.onrender.com

# Optional server port (defaults to 3001).
# PORT=3001
